#title "Kuhlau Sonatina Op.20 No.1 II. Andante"

@2 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        31, 10,  5,  7,  4, 30, 2,  1,  3,  0,  0,
        31,  5,  3,  7,  2,  8, 2,  1,  3,  0,  0,
        31, 14,  8,  7,  8, 46, 3,  7,  7,  0,  0,
        31,  6,  4,  7,  3, 14, 2,  1,  7,  0,  0,
    /* CON FL OP */
        4,  3, 15
}

; l1(음길이), r1(쉼표) 1박 → 4칸
; l2(음길이), r2(쉼표) 2박 → 2칸
; l4(음길이), r4(쉼표) 1박 → 1칸
; l8(음길이), r8(쉼표) 0.5박 → 0.5칸
; l16(음길이), r16(쉼표) 0.25박 → 0.25칸  
; 띄어쓰기 칸 3개에 1묶음 음표

A @2 t120 o4 l4 f l16 a
A l4 >ccc cf<a
A l2 >c l8 <b>dc<b-   r4 l8 >b- l16 g
A l4 e r4   l8 g l16 e l4 c r4   l8 d l16 <b-

#title "Kuhlau Sonatina Op.20 No.1 II. Andante"

@2 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        31, 10,  5,  7,  4, 30, 2,  1,  3,  0,  0,
        31,  5,  3,  7,  2,  8, 2,  1,  3,  0,  0,
        31, 14,  8,  7,  8, 46, 3,  7,  7,  0,  0,
        31,  6,  4,  7,  3, 14, 2,  1,  7,  0,  0,
    /* CON FL OP */
        4,  3, 15
}

A @2 t90 o4 l8 fa >ccc cf<a >c<b>dc <a >bg l16 e


C @2 t90 o4 r4 l8 r8 aa aaa l4. a l8 a r4 l16 gaa

D @2 t90 o4 r4 l8 r8 ff fff l4. e l8 e r4 l16 gea

E @2 t90 o4 r4 l8 r8 dd ddd l4. c l8 c r4 l16 gea
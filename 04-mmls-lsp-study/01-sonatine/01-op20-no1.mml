#title "My first song"

; Park your cursor in this voice, then give it a spin in the mmlx panel's FM Voice tab.
; Synth Brass
@1 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        28, 4,  0,  5,  1, 37, 2,  1,  7,  0,  0,
        22, 9,  1,  2,  1, 47, 2, 12,  0,  0,  0,
        29, 4,  3,  6,  1, 37, 1,  3,  3,  0,  0,
        15, 7,  0,  5, 10,  0, 2,  1,  0,  0,  1,
    /* CON FL OP */
        2,  7, 15
}

; Grand Piano (FM 근사치)
; CON 4 = 두 겹 구조: OP1 → OP2(캐리어), OP3 → OP4(캐리어)
; OP1: 밝기 담당. 캐리어보다 빨리 감쇠해서 처음엔 밝고 점점 부드러워짐
; OP2: 몸통 소리. AR 31(즉시 발음), D2R 3(누르고 있어도 서서히 작아짐)
; OP3: 해머 타격음. MUL 7의 높은 배음이 아주 빨리 사라짐
; OP4: 두 번째 층. OP2와 반대 방향 DT1로 살짝 어긋나 현의 맥놀이를 흉내 냄
@2 = {
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        31, 10,  5,  7,  4, 30, 2,  1,  3,  0,  0,
        31,  5,  3,  7,  2,  8, 2,  1,  3,  0,  0,
        31, 14,  8,  7,  8, 46, 3,  7,  7,  0,  0,
        31,  6,  4,  7,  3, 14, 2,  1,  7,  0,  0,
    /* CON FL OP */
        4,  3, 15
}

; Violin (FM 근사치)
@3 = {                                             ; [연결③] 음색 3번 정의
    /* AR  D1R D2R RR D1L  TL KS MUL DT1 DT2 AME */
        18,  0,  0,  6,  0, 30, 1,  1,  0,  0,  0,   ; OP1 톱니파 같은 현 소리 (피드백)
        22,  6,  0,  6,  4, 55, 1,  3,  0,  0,  0,   ; OP2 활이 긁는 높은 배음
        18,  2,  0,  6,  2, 40, 1,  1,  0,  0,  0,   ; OP3 중간 다리
        16,  0,  0,  7,  0,  0, 1,  1,  0,  0,  0,   ; OP4 캐리어
    /* CON FL OP */
        2,  6, 15
}

